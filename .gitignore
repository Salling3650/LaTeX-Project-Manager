# macOS
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride

# Templates – keep only main.tex template
templates/*
!templates/main.tex

# Projects directory (user-created projects)
projects/*
!projects/.gitkeep

# LaTeX build artifacts
**/.build/
*.aux
*.log
*.fdb_latexmk
*.fls
*.synctex.gz
*.toc
*.out
missfont.log
*.pdf

