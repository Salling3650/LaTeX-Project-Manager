# macOS
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride

# Templates – keep main.tex and test templates (Lille/Stor opgave)
templates/*
!templates/main.tex
!templates/Lille\ opgave/
!templates/Lille\ opgave/**
!templates/Stor\ opgave/
!templates/Stor\ opgave/**
templates/**/.DS_Store

# Projects directory (user-created projects)
projects/*
!projects/.gitkeep

# LaTeX build artifacts
**/.build/
*.aux
*.log
*.fdb_latexmk
*.fls
*.synctex.gz
*.toc
*.out
missfont.log
*.pdf
